{
  "name": "dsh-toolkit",
  "version": "2.0.0",
  "description": "DSH Plugin Toolkit - 20 deterministic tools served via MCP / A2A v1.0 / REST gateway, with loop engineering and cost governance",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "dsh": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-toolkit.git"
  },
  "keywords": [
    "mcp",
    "a2a",
    "agent",
    "toolkit",
    "plugins",
    "koishi",
    "ollama"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "node scripts/build-plugins.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "bridge": "node dist/bridge/server.js",
    "a2a:gen": "node dist/cli.js a2a gen",
    "demo": "node dist/cli.js demo carbon",
    "scaffold": "node dist/cli.js scaffold"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
